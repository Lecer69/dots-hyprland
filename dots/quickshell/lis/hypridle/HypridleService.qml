import QtQuick
import Quickshell
import Quickshell.Io
import qs.settings.data

// Runs hypridle with a config built from the timers in Settings > Idle.
// hypridle doesn't reload its config, so it is restarted when a timer
// changes. It is started detached so it outlives shell reloads.
QtObject {
    id: root

    readonly property string configPath: Quickshell.env("HOME") + "/.config/lis/hypridle.conf"
    readonly property string config: render(SettingsData.s.hypridle)

    // What configPath holds, i.e. what a running hypridle was started with
    property string _written: ""

    // Arguments: the config path, then "restart" to replace a hypridle that
    // was already started with it. Two hypridles fight over D-Bus, so the
    // old one has to be gone before the new one starts.
    readonly property string _launchScript: `
        if [ "$2" != restart ] && pgrep -xf "hypridle -c $1" >/dev/null; then exit 0; fi
        pkill -x hypridle
        for _ in $(seq 20); do pgrep -x hypridle >/dev/null || break; sleep 0.1; done
        exec hypridle -c "$1"
    `

    onConfigChanged: applyTimer.restart()

    Component.onCompleted: {
        root._written = configFile.text()
        root.apply()
    }

    // The timers are in minutes, hypridle's timeouts in seconds
    function render(h) {
        return [
            "# Generated by lis from Settings > Idle; edits here are overwritten",
            "",
            "general {",
            "    lock_cmd = if [ -f ~/.config/hypr/hyprland.lua ]; then hyprctl dispatch 'hl.dsp.global(\"quickshell:lock\")'; else hyprctl dispatch global quickshell:lock; fi",
            "    before_sleep_cmd = loginctl lock-session",
            "    after_sleep_cmd = if [ -f ~/.config/hypr/hyprland.lua ]; then hyprctl dispatch 'hl.dsp.global(\"quickshell:lockFocus\")'; else hyprctl dispatch global quickshell:lockFocus; fi",
            "    inhibit_sleep = 3",
            "}",
            "",
            "listener {",
            `    timeout = ${h.lockTimeout * 60}`,
            "    on-timeout = loginctl lock-session",
            "}",
            "",
            "listener {",
            `    timeout = ${h.screenOffTimeout * 60}`,
            "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'",
            "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'",
            "}",
            "",
            "listener {",
            `    timeout = ${h.suspendTimeout * 60}`,
            "    on-timeout = systemctl suspend || loginctl suspend",
            "}",
            ""
        ].join("\n")
    }

    function apply() {
        const changed = root.config !== root._written
        if (changed) {
            configFile.setText(root.config)
            root._written = root.config
        }
        // An unchanged config leaves a running hypridle alone, so its idle
        // timers aren't reset by every shell reload
        Quickshell.execDetached(["sh", "-c", root._launchScript, "sh", root.configPath, changed ? "restart" : ""])
    }

    // Sliders write on every step; restart hypridle once they settle
    property Timer applyTimer: Timer {
        interval: 500
        onTriggered: root.apply()
    }

    // Atomic writes (temp file + rename), done before setText returns
    property FileView configFile: FileView {
        path: root.configPath
        blockLoading: true
        blockWrites: true
        printErrors: false
    }
}
