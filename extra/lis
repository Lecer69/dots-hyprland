#!/usr/bin/env bash

case "$1" in
    matugen)
        [ "$#" -ne 3 ] && exit 1
        matugen color hex "$2" -m dark

        XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
        color=$(tr -d '\n' < "$XDG_STATE_HOME/quickshell/user/generated/color.txt")

        case "$3" in
            content)      sv_num=0 ;;
            expressive)   sv_num=1 ;;
            fidelity)     sv_num=2 ;;
            monochrome)   sv_num=3 ;;
            neutral)      sv_num=4 ;;
            tonal-spot)   sv_num=5 ;;
            vibrant)      sv_num=6 ;;
            rainbow)      sv_num=7 ;;
            fruit-salad)  sv_num=8 ;;
            "")           sv_num=5 ;;
            *)
                echo "Unknown scheme variant: $3" >&2
                exit 1
                ;;
        esac

        kde-material-you-colors -d --color "$color" -sv "$sv_num"
        ;;
    7z)
        [ "$#" -ne 3 ] && exit 1
        ARCHIVE="$2"
        TARGET="$3"
        7z a -t7z "$ARCHIVE" "$TARGET" -mx=9 -m0=lzma2 -mmt=on -ms=on
        notify-send '7zip Compressor' 'File compressed successfully'
        ;;
    7zl)
        [ "$#" -ne 3 ] && exit 1
        ARCHIVE="$2"
        TARGET="$3"
        7z a -t7z "$ARCHIVE" "$TARGET" -mx=0 -mmt=on
        notify-send '7zip Compressor' 'File compressed successfully'
        ;;
    compress)
        [ "$#" -lt 3 ] && exit 1
        INPUT="$2"
        OUTPUT="$3"
        CRF="${4:-23}"
        ffmpeg -i "$INPUT" \
        -c:v libx264 -crf "$CRF" -preset slow \
        -profile:v high -level 4.2 -pix_fmt yuv420p \
        -c:a aac -b:a 128k \
        "$OUTPUT"
        notify-send 'Video Compressor' 'Video compressed successfully'
        ;;
    shutdown)
        pkill -TERM -f zen
        pkill -TERM -f brave
        pkill -TERM -f brave-origin
        pkill -TERM -f intellij
        pkill -TERM -f code
        pkill -TERM -f kitty

        for i in $(seq 1 20); do
            pgrep -f 'zen|brave|brave-origin|intellij|code|kitty' >/dev/null || break
            sleep 0.3
        done

        systemctl poweroff
        ;;
    reboot)
        pkill -TERM -f zen
        pkill -TERM -f brave
        pkill -TERM -f brave-origin
        pkill -TERM -f intellij
        pkill -TERM -f code
        pkill -TERM -f kitty

        for i in $(seq 1 20); do
            pgrep -f 'zen|brave|brave-origin|intellij|code|kitty' >/dev/null || break
            sleep 0.3
        done

        systemctl reboot
        ;;
    mirrors)
        if ! command -v reflector >/dev/null 2>&1; then
            echo "lis mirrors: reflector is not installed" >&2
            exit 1
        fi

        # Configuration (environment):
        #   LIS_MIRROR_COUNTRY   one or more countries/codes, separated by comma,
        #                        space or semicolon (e.g. "us,de" / "France Germany").
        #                        Alias: LIS_MIRROR_COUNTRIES
        #   LIS_MIRROR_AMOUNT    number of mirrors to keep, default 20.
        #                        Alias: LIS_MIRROR_COUNT
        country="${LIS_MIRROR_COUNTRY:-${LIS_MIRROR_COUNTRIES:-}}"
        amount="${LIS_MIRROR_AMOUNT:-${LIS_MIRROR_COUNT:-20}}"

        # Normalise multiple countries into reflector's comma-separated form.
        country=$(printf '%s' "$country" | tr ' ;' ',,' | sed 's/,,*/,/g; s/^,//; s/,$//')

        if ! [[ "$amount" =~ ^[1-9][0-9]*$ ]]; then
            echo "lis mirrors: invalid LIS_MIRROR_AMOUNT: $amount" >&2
            exit 1
        fi

        echo "lis mirrors: countries='${country:-all}' amount=$amount"

        tmp=$(mktemp) || exit 1
        args=(--protocol https --latest "$amount" --sort rate --verbose --save "$tmp")
        [ -n "$country" ] && args=(--country "$country" "${args[@]}")
        echo "lis mirrors: running reflector ${args[*]}"

        sudo -n cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak 2>/dev/null \
            || sudo cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak \
            || { echo "lis mirrors: failed to back up /etc/pacman.d/mirrorlist" >&2; rm -f "$tmp"; exit 1; }

        if ! reflector "${args[@]}"; then
            echo "lis mirrors: reflector failed" >&2
            rm -f "$tmp"
            exit 1
        fi

        selected=$(grep -c '^Server' "$tmp" || true)
        echo "lis mirrors: selected ${selected:-0} mirror(s):"
        grep '^Server' "$tmp" | sed 's/^/    /'

        sudo -n install -m 644 -o root -g root "$tmp" /etc/pacman.d/mirrorlist 2>/dev/null \
            || sudo install -m 644 -o root -g root "$tmp" /etc/pacman.d/mirrorlist \
            || { echo "lis mirrors: failed to install /etc/pacman.d/mirrorlist" >&2; rm -f "$tmp"; exit 1; }
        rm -f "$tmp"

        sudo -n env https_proxy="$https_proxy" http_proxy="$http_proxy" pacman -Syy --noconfirm 2>/dev/null \
            || sudo env https_proxy="$https_proxy" http_proxy="$http_proxy" pacman -Syy \
            || { echo "lis mirrors: pacman -Syy failed" >&2; exit 1; }

        echo "lis mirrors: done (${selected:-0} mirror(s), backup at /etc/pacman.d/mirrorlist.bak)"
        ;;
    *)
        echo "Usage:"
        echo "  lis 7z <archive> <folder_or_file> ==> Compress folders or files"
        echo "  lis 7zl <archive> <folder_or_file> ==> Compress lightly folders or files"
        echo "  lis compress <input.mp4> <output.mp4> [size, def:23] ==> Compress a video"
        echo "  lis shutdown ==> Safely shuts down"
        echo "  lis reboot ==> Safely reboots"
        echo "  lis mirrors ==> Update pacman mirrorlist with reflector"
        echo "      env: LIS_MIRROR_COUNTRY='us,de' LIS_MIRROR_AMOUNT=20"
        ;;
esac
